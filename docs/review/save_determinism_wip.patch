diff --git a/crates/nd_sim/src/traffic/live.rs b/crates/nd_sim/src/traffic/live.rs
new file mode 100644
index 0000000..cdea4aa
--- /dev/null
+++ b/crates/nd_sim/src/traffic/live.rs
@@ -0,0 +1,105 @@
+//! [review] The lane network's live state in a save. The network itself is
+//! derived (rebuilt from the roads on load), but its signals, turn counts,
+//! adapted arrows and closures are not: without them a loaded game's cars
+//! met different lights from the first tick and the run drifted from the
+//! one left going. Only that state is saved, by lane, junction and
+//! approach index, and put back on the rebuilt network when its shape
+//! matches (a save from before carries none and starts afresh, as before).
+
+use super::*;
+
+/// One lane's live state.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct LaneLive {
+    pub green: bool,
+    pub red_for: f32,
+    pub arrows: u8,
+    pub permitted: bool,
+    pub blocked: bool,
+    pub rail_closed: bool,
+}
+
+/// One junction's live state.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct JunctionLive {
+    pub phase: usize,
+    pub arrow: f32,
+    pub timer: f32,
+    pub left_turns: u32,
+    pub left_wait_sum: f32,
+    pub left_wait_max: f32,
+}
+
+/// One approach's live state.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct ApproachLive {
+    pub arrows: Vec<u8>,
+    pub fixed: bool,
+    pub counts: [f32; 3],
+}
+
+/// The live state of a whole lane network.
+#[derive(Clone, Debug, Default, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct NetLive {
+    pub lanes: Vec<LaneLive>,
+    pub junctions: Vec<JunctionLive>,
+    pub approaches: Vec<ApproachLive>,
+    pub version: u64,
+    pub arrows_version: u64,
+    pub rail_closed_any: bool,
+}
+
+impl NetLive {
+    pub fn of(net: &LaneNetwork) -> NetLive {
+        NetLive {
+            lanes: net.lanes.iter().map(|l| LaneLive { green: l.green, red_for: l.red_for, arrows: l.arrows, permitted: l.permitted, blocked: l.blocked, rail_closed: l.rail_closed }).collect(),
+            junctions: net.intersections.iter().map(|i| JunctionLive { phase: i.phase, arrow: i.arrow, timer: i.timer, left_turns: i.left_turns, left_wait_sum: i.left_wait_sum, left_wait_max: i.left_wait_max }).collect(),
+            approaches: net.approaches.iter().map(|a| ApproachLive { arrows: a.arrows.clone(), fixed: a.fixed, counts: a.counts }).collect(),
+            version: net.version,
+            arrows_version: net.arrows_version,
+            rail_closed_any: net.rail_closed_any,
+        }
+    }
+
+    /// Put the state back on `net`, when it has the shape the state was
+    /// taken from (the same lanes, junctions, approaches and phases);
+    /// otherwise leave the fresh network as it is. Whether it was applied.
+    pub fn apply(&self, net: &mut LaneNetwork) -> bool {
+        let fits = self.lanes.len() == net.lanes.len()
+            && self.junctions.len() == net.intersections.len()
+            && self.approaches.len() == net.approaches.len()
+            && self.junctions.iter().zip(&net.intersections).all(|(j, i)| j.phase < i.phases.len().max(1))
+            && self.approaches.iter().zip(&net.approaches).all(|(s, a)| s.arrows.len() == a.arrows.len());
+        if !fits {
+            return false;
+        }
+        for (l, s) in net.lanes.iter_mut().zip(&self.lanes) {
+            (l.green, l.red_for, l.arrows, l.permitted, l.blocked, l.rail_closed) = (s.green, s.red_for, s.arrows, s.permitted, s.blocked, s.rail_closed);
+        }
+        for (i, s) in net.intersections.iter_mut().zip(&self.junctions) {
+            (i.phase, i.arrow, i.timer, i.left_turns, i.left_wait_sum, i.left_wait_max) = (s.phase, s.arrow, s.timer, s.left_turns, s.left_wait_sum, s.left_wait_max);
+        }
+        for (a, s) in net.approaches.iter_mut().zip(&self.approaches) {
+            a.arrows.clone_from(&s.arrows);
+            (a.fixed, a.counts) = (s.fixed, s.counts);
+        }
+        (net.version, net.arrows_version, net.rail_closed_any) = (self.version, self.arrows_version, self.rail_closed_any);
+        true
+    }
+}
+
+/// `Traffic::net` in a save: its live state only.
+pub(super) fn save_net<S: serde::Serializer>(net: &LaneNetwork, s: S) -> Result<S::Ok, S::Error> {
+    NetLive::of(net).serialize(s)
+}
+
+/// `Traffic::net` from a save: an empty network holding the saved state
+/// until `Traffic::rebuild` builds the real one and puts it back.
+pub(super) fn load_net<'de, D: serde::Deserializer<'de>>(d: D) -> Result<LaneNetwork, D::Error> {
+    let live = NetLive::deserialize(d)?;
+    Ok(LaneNetwork { pending_live: Some(Box::new(live)), ..LaneNetwork::default() })
+}
